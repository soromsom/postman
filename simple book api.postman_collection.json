  "item": [
    {
      "name": "API status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response time is less than 6000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(6000);\n});\n\npm.test(\"Response body contains status OK\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.status).to.eql(\"OK\");\n});\n\nconst response = pm.response.json();\n\nconsole.log(response.status);\nconsole.log(response[\"status\"]);\n\npm.test(\"status should be OK\", () => {\n    pm.expect(response.status).to.eql(\"OK\");\n});\n\nPostman.setNextRequest (\"Lists of books\");\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/status",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "status"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Lists of books",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\nconst response = pm.response.json();\n\nconst nonFictionBooks = response.filter((book) => book.available === true);\n\nif (nonFictionBooks.length > 0) {\n    const book = nonFictionBooks[0];\n    console.log(book);\n\n    pm.test(\"Book found\", () => {\n        pm.expect(book).to.be.an('object');\n        pm.expect(book.available).to.be.true;\n        pm.expect(book.type).to.eql(\"non-fiction\");\n    });\n\n    pm.globals.set(\"bookid\", book.id);\n} else {\n    pm.test(\"Book found\", () => {\n        throw new Error(\"No available non-fiction books found\");\n    });\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/books?type=non-fiction",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "type",
              "value": "non-fiction"
            },
            {
              "key": "limit",
              "value": "20",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
